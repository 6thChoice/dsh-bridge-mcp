{
  "name": "dsh-bridge-mcp",
  "version": "0.1.0",
  "description": "Process-external client for a running DeepSeek Harness Web host: send one message to a session and read its answer back over MCP or the CLI.",
  "type": "module",
  "bin": {
    "dsh-bridge": "dist/cli.js",
    "dsh-bridge-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "license": "MIT",
  "author": "6thChoice <6thChoice@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6thChoice/dsh-bridge-mcp.git"
  },
  "homepage": "https://github.com/6thChoice/dsh-bridge-mcp#readme",
  "bugs": {
    "url": "https://github.com/6thChoice/dsh-bridge-mcp/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "mcp",
    "model-context-protocol",
    "agent",
    "session",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "build:tests": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run build:tests && node --test --test-concurrency=1 \"dist-test/tests/*.test.js\"",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
